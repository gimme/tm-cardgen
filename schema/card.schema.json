{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gimme.github.io/tm-cardgen/card.schema.json",
  "title": "tm-cardgen card",
  "description": "A custom Terraforming Mars card. Row strings (body, active, requirement, vp) are validated by the app, not this schema.",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Card name (title band)"
    },
    "cost": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "enum": [
            "X"
          ]
        }
      ],
      "description": "MC cost (integer or \"X\")"
    },
    "tags": {
      "type": "array",
      "items": {
        "enum": [
          "building",
          "space",
          "science",
          "power",
          "earth",
          "jovian",
          "city",
          "microbe",
          "plant",
          "animal",
          "event",
          "venus",
          "mars",
          "moon",
          "wild",
          "galactic",
          "planetary",
          "infrastructure",
          "radioactive",
          "multitag"
        ]
      },
      "description": "Tag list, order = left to right; an event tag makes the card red"
    },
    "requirement": {
      "type": "string",
      "description": "Requirement, e.g. \"max 6% {oxygen}\" or \"{science-tag science-tag}\""
    },
    "active": {
      "type": [
        "array",
        "string",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Rows of the action area at the top (a list, or one string); makes the card blue"
    },
    "body": {
      "type": [
        "array",
        "string",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Rows of the box under the art (a list of row strings, or one string)"
    },
    "vp": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "Victory points: an integer, or a row set in the disc, the bare number in its style: \"1 {/ 2 microbe}\""
    },
    "flavor": {
      "type": "string",
      "description": "Flavor text (italic, bottom of the body box)"
    },
    "number": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ],
      "description": "Card number (bottom-right box); an integer is padded to 3 digits"
    },
    "art": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "description": "Art file name, as listed in the Art panel"
            },
            "zoom": {
              "type": "number",
              "minimum": 1,
              "description": "Scale beyond cover-fit; 1 = exact cover"
            },
            "offset": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Pan [x, y] in mm, clamped so no gaps appear"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Art file name, or {file, zoom, offset: [mm, mm]}; left out, a drawn Mars sky"
    },
    "artist": {
      "type": "string",
      "description": "Artist credit, printed up the right edge of the art"
    },
    "seed": {
      "type": "integer",
      "description": "Reroll the frame's crystal texture (any integer; default derives from the name)"
    }
  },
  "additionalProperties": false
}
